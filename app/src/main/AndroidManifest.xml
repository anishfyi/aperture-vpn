<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".ApertureApp"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aperture"
        tools:replace="android:name,android:theme,android:icon,android:label,android:roundIcon,android:extractNativeLibs">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Aperture">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ics-openvpn's OpenVPNService builds its foreground-notification and
          graph PendingIntents against "<applicationId>.activities.MainActivity".
          We keep our activity at the package root, so alias that name to it;
          without this the status notification points at a missing component.
        -->
        <activity-alias
            android:name=".activities.MainActivity"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!--
          Run every OpenVPN component in the main app process, not the vendor's
          default ":openvpn" child process. The child process re-runs our
          Application from scratch; consolidating into the already-initialized
          main process removes that startup variable and keeps the VPN service
          in the same process as the UI that started it.
        -->
        <service
            android:name="de.blinkt.openvpn.core.OpenVPNService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:process="io.github.anishfyi.aperture"
            tools:node="merge"
            tools:replace="android:process">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <service
            android:name="de.blinkt.openvpn.core.OpenVPNStatusService"
            android:process="io.github.anishfyi.aperture"
            tools:node="merge"
            tools:replace="android:process" />

        <service
            android:name="de.blinkt.openvpn.core.keepVPNAlive"
            android:process="io.github.anishfyi.aperture"
            tools:node="merge"
            tools:replace="android:process" />

        <service
            android:name="de.blinkt.openvpn.api.ExternalOpenVPNService"
            android:process="io.github.anishfyi.aperture"
            tools:node="merge"
            tools:replace="android:process" />
    </application>
</manifest>
